{
  "rules": {
    "users": {
      "$uid": {
        ".read": "auth != null && auth.uid == $uid",
        ".write": "auth != null && auth.uid == $uid",
        "lastPostTimestamp": {
          ".validate": "newData.isNumber() && (!data.exists() || newData.val() >= data.val() + 5000)"
        },
        "profile": {
          "displayName": {
            ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 40"
          },
          "bio": {
            ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 150"
          },
          "$other": {
            ".validate": false
          }
        },
        "$other": {
          ".validate": false
        }
      }
    },
    "typing": {
      ".read": true,
      "$uid": {
        ".write": "auth != null && auth.uid == $uid",
        ".validate": "newData.hasChildren(['name', 'timestamp'])",
        "name": {
          ".validate": "newData.isString() && newData.val().length <= 100"
        },
        "timestamp": {
          ".validate": "newData.isNumber()"
        },
        "$other": {
          ".validate": false
        }
      }
    },
    "messages": {
      ".read": true,
      ".indexOn": [
        "timestamp",
        "authorId"
      ],
      "$message_id": {
        ".write": "auth != null && (!data.exists() || data.child('authorId').val() === auth.uid)",
        ".validate": "newData.hasChildren(['text', 'author', 'authorId', 'timestamp'])",
        "text": {
          ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 250"
        },
        "author": {
          ".validate": "data.exists() ? newData.val() === data.val() : (newData.val() === auth.token.name || newData.val() === root.child('users').child(auth.uid).child('profile/displayName').val())"
        },
        "authorId": {
          ".validate": "newData.val() === auth.uid"
        },
        "timestamp": {
          ".validate": "data.exists() ? newData.val() === data.val() : (newData.val() <= now && newData.val() >= now - 30000)"
        },
        "editedAt": {
          ".validate": "newData.isNumber()"
        },
        "photoURL": {
          ".validate": "newData.isString()"
        },
        "type": {
          ".validate": "newData.isString() && (newData.val() === 'poll' || newData.val() === 'gif' || newData.val() === 'image')"
        },
        "gifUrl": {
          ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 500 && newData.val().matches(/^https:\\/\\/media\\.tenor\\.com\\/.+/)"
        },
        "gifPreviewUrl": {
          ".validate": "newData.isString() && newData.val().length <= 500 && (newData.val().length === 0 || newData.val().matches(/^https:\\/\\/media\\.tenor\\.com\\/.+/))"
        },
        "gifAlt": {
          ".validate": "newData.isString() && newData.val().length <= 200"
        },
        "poll": {
          "options": {
            ".validate": "newData.hasChildren(['0', '1'])",
            "$index": {
              ".validate": "($index === '0' || $index === '1' || $index === '2' || $index === '3') && newData.isString() && newData.val().length > 0 && newData.val().length <= 60"
            }
          },
          "$other": {
            ".validate": false
          }
        },
        "imageUrl": {
          ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 500 && newData.val().matches(/^https:\\/\\/.+/)"
        },
        "imageAlt": {
          ".validate": "newData.isString() && newData.val().length <= 200"
        },
        "countryCode": {
          ".validate": "newData.isString() && newData.val().matches(/^[A-Z]{2}$/)"
        },
        "countryName": {
          ".validate": "newData.isString() && newData.val().length <= 100"
        },
        "replies": {
          "$reply_id": {
            ".write": "auth != null && (!data.exists() || data.child('authorId').val() === auth.uid)",
            ".validate": "newData.hasChildren(['text', 'author', 'authorId', 'timestamp'])",
            "text": {
              ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 250"
            },
            "author": {
              ".validate": "data.exists() ? newData.val() === data.val() : (newData.val() === auth.token.name || newData.val() === root.child('users').child(auth.uid).child('profile/displayName').val())"
            },
            "authorId": {
              ".validate": "newData.val() === auth.uid"
            },
            "timestamp": {
              ".validate": "data.exists() ? newData.val() === data.val() : (newData.val() <= now && newData.val() >= now - 30000)"
            },
            "$other": {
              ".validate": false
            }
          }
        },
        "$other": {
          ".validate": false
        }
      }
    },
    "pollVotes": {
      ".read": true,
      "$message_id": {
        ".write": "auth != null && !newData.exists() && root.child('messages').child($message_id).child('authorId').val() === auth.uid",
        "$uid": {
          ".write": "auth != null && auth.uid === $uid && !data.exists()",
          ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 3 && ((newData.val() === 0 && root.child('messages').child($message_id).child('poll/options/0').exists()) || (newData.val() === 1 && root.child('messages').child($message_id).child('poll/options/1').exists()) || (newData.val() === 2 && root.child('messages').child($message_id).child('poll/options/2').exists()) || (newData.val() === 3 && root.child('messages').child($message_id).child('poll/options/3').exists()))"
        }
      }
    }
  }
}
